{
  "contract_name": "oroswap-revenue-router",
  "contract_version": "1.0.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "first_hop_receiver",
      "forward_memo",
      "ibc_channel",
      "owner",
      "usdc_denom"
    ],
    "properties": {
      "first_hop_receiver": {
        "description": "First-hop receiver — used verbatim as the outbound MsgTransfer `receiver`. Typically a Noble address (`noble1...`).",
        "type": "string"
      },
      "forward_memo": {
        "description": "JSON memo carrying PFM / CCTP forwarding instructions. Inserted verbatim into the outbound MsgTransfer's `memo` field.",
        "type": "string"
      },
      "ibc_channel": {
        "description": "Outbound IBC channel on Zigchain (e.g. \"channel-0\", typically to Noble).",
        "type": "string"
      },
      "ibc_timeout_secs": {
        "description": "IBC packet timeout in seconds (default: 600).",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "max_bridge_per_tx": {
        "description": "Maximum USDC per `BridgeUsdc` call. `None` = uncapped.",
        "anyOf": [
          {
            "$ref": "#/definitions/Uint128"
          },
          {
            "type": "null"
          }
        ]
      },
      "owner": {
        "description": "Contract owner.",
        "type": "string"
      },
      "usdc_denom": {
        "description": "USDC IBC denom on Zigchain (e.g. \"ibc/6490A7...\").",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "definitions": {
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Bridge USDC out of this contract to the destination encoded in `Config.first_hop_receiver` + `Config.forward_memo`. Callable by the owner or any registered keeper.\n\nThe caller can only choose how much to bridge — not where. The destination is owner-controlled policy in Config; a hijacked keeper can only trigger transfers to the configured treasury.",
        "type": "object",
        "required": [
          "bridge_usdc"
        ],
        "properties": {
          "bridge_usdc": {
            "type": "object",
            "properties": {
              "amount": {
                "description": "Amount to bridge. If None, bridges the full contract balance.",
                "anyOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Update contract configuration. Owner only.\n\n`max_bridge_per_tx`: - omitted / null  → cap left unchanged - Some(Some(x))   → set cap to x - Some(None)      → clear the cap (uncapped)",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "type": "object",
            "properties": {
              "first_hop_receiver": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "forward_memo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ibc_channel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ibc_timeout_secs": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "max_bridge_per_tx": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/Uint128"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "usdc_denom": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Add an authorized keeper. Owner only.",
        "type": "object",
        "required": [
          "add_keeper"
        ],
        "properties": {
          "add_keeper": {
            "type": "object",
            "required": [
              "keeper"
            ],
            "properties": {
              "keeper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Remove a keeper. Owner only.",
        "type": "object",
        "required": [
          "remove_keeper"
        ],
        "properties": {
          "remove_keeper": {
            "type": "object",
            "required": [
              "keeper"
            ],
            "properties": {
              "keeper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Recover any token from the contract. Owner only.",
        "type": "object",
        "required": [
          "emergency_withdraw"
        ],
        "properties": {
          "emergency_withdraw": {
            "type": "object",
            "required": [
              "denom"
            ],
            "properties": {
              "amount": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Uint128"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "denom": {
                "type": "string"
              },
              "recipient": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Proposes a new owner. The proposed owner must call ClaimOwnership.",
        "type": "object",
        "required": [
          "propose_new_owner"
        ],
        "properties": {
          "propose_new_owner": {
            "type": "object",
            "required": [
              "expires_in",
              "owner"
            ],
            "properties": {
              "expires_in": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Removes the pending ownership proposal.",
        "type": "object",
        "required": [
          "drop_ownership_proposal"
        ],
        "properties": {
          "drop_ownership_proposal": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Claims a pending ownership proposal. Only callable by the proposed new owner.",
        "type": "object",
        "required": [
          "claim_ownership"
        ],
        "properties": {
          "claim_ownership": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Pause or unpause bridge operations. Owner only.",
        "type": "object",
        "required": [
          "set_paused"
        ],
        "properties": {
          "set_paused": {
            "type": "object",
            "required": [
              "paused"
            ],
            "properties": {
              "paused": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "usdc_balance"
        ],
        "properties": {
          "usdc_balance": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Paginated list of authorised keepers.\n\n`start_after`: skip keys ≤ this bech32 (exclusive). `limit`: max entries to return (default 30, capped at 100).",
        "type": "object",
        "required": [
          "keepers"
        ],
        "properties": {
          "keepers": {
            "type": "object",
            "properties": {
              "limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0.0
              },
              "start_after": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns exactly what the next `BridgeUsdc` call would send to chain — owner sanity-check before enabling the keeper.",
        "type": "object",
        "required": [
          "preview_bridge"
        ],
        "properties": {
          "preview_bridge": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MigrateMsg",
    "type": "object",
    "additionalProperties": false
  },
  "sudo": null,
  "responses": {
    "config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ConfigResponse",
      "type": "object",
      "required": [
        "first_hop_receiver",
        "forward_memo",
        "ibc_channel",
        "ibc_timeout_secs",
        "owner",
        "paused",
        "usdc_denom"
      ],
      "properties": {
        "first_hop_receiver": {
          "type": "string"
        },
        "forward_memo": {
          "type": "string"
        },
        "ibc_channel": {
          "type": "string"
        },
        "ibc_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_bridge_per_tx": {
          "anyOf": [
            {
              "$ref": "#/definitions/Uint128"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "usdc_denom": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    },
    "keepers": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "KeepersResponse",
      "type": "object",
      "required": [
        "keepers"
      ],
      "properties": {
        "keepers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "preview_bridge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PreviewBridgeResponse",
      "description": "What the contract would put on chain on the next BridgeUsdc call. The keeper cannot affect any of these values.",
      "type": "object",
      "required": [
        "channel",
        "denom",
        "memo",
        "receiver",
        "timeout_secs"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "denom": {
          "type": "string"
        },
        "max_bridge_per_tx": {
          "anyOf": [
            {
              "$ref": "#/definitions/Uint128"
            },
            {
              "type": "null"
            }
          ]
        },
        "memo": {
          "type": "string"
        },
        "receiver": {
          "type": "string"
        },
        "timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    },
    "usdc_balance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BalanceResponse",
      "type": "object",
      "required": [
        "amount",
        "denom"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "denom": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    }
  }
}
