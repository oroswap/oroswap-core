{
  "contract_name": "oroswap-airdrop",
  "contract_version": "1.0.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "admin"
    ],
    "properties": {
      "admin": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "add_airdrop"
        ],
        "properties": {
          "add_airdrop": {
            "type": "object",
            "required": [
              "apy_bonus_bps",
              "eligibility",
              "initial_claim_percent",
              "is_native",
              "start_time",
              "token_address",
              "vesting_end_time",
              "vesting_start_time"
            ],
            "properties": {
              "apy_bonus_bps": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "eligibility": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/definitions/Uint128"
                    }
                  ],
                  "maxItems": 2,
                  "minItems": 2
                }
              },
              "expiry_time": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "initial_claim_percent": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "is_native": {
                "description": "true = native/IBC denom, false = CW20 contract",
                "type": "boolean"
              },
              "start_time": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "token_address": {
                "type": "string"
              },
              "vesting_end_time": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "vesting_start_time": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "toggle_airdrop"
        ],
        "properties": {
          "toggle_airdrop": {
            "type": "object",
            "required": [
              "active",
              "id"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Claim airdrop tokens. One-time settlement.",
        "type": "object",
        "required": [
          "claim"
        ],
        "properties": {
          "claim": {
            "type": "object",
            "required": [
              "airdrop_id"
            ],
            "properties": {
              "airdrop_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "deposit_funds"
        ],
        "properties": {
          "deposit_funds": {
            "type": "object",
            "required": [
              "amount",
              "is_native",
              "token_address"
            ],
            "properties": {
              "amount": {
                "$ref": "#/definitions/Uint128"
              },
              "is_native": {
                "type": "boolean"
              },
              "token_address": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "withdraw_funds"
        ],
        "properties": {
          "withdraw_funds": {
            "type": "object",
            "required": [
              "amount",
              "is_native",
              "token_address"
            ],
            "properties": {
              "amount": {
                "$ref": "#/definitions/Uint128"
              },
              "is_native": {
                "type": "boolean"
              },
              "token_address": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Proposes a new admin. The proposed admin must call ClaimOwnership.",
        "type": "object",
        "required": [
          "propose_new_owner"
        ],
        "properties": {
          "propose_new_owner": {
            "type": "object",
            "required": [
              "expires_in",
              "owner"
            ],
            "properties": {
              "expires_in": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Removes the pending ownership proposal.",
        "type": "object",
        "required": [
          "drop_ownership_proposal"
        ],
        "properties": {
          "drop_ownership_proposal": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Claims a pending ownership proposal. Only callable by the proposed new admin.",
        "type": "object",
        "required": [
          "claim_ownership"
        ],
        "properties": {
          "claim_ownership": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "update_eligibility"
        ],
        "properties": {
          "update_eligibility": {
            "type": "object",
            "required": [
              "airdrop_id",
              "eligibility"
            ],
            "properties": {
              "airdrop_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "eligibility": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/definitions/Uint128"
                    }
                  ],
                  "maxItems": 2,
                  "minItems": 2
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin-only. Update the APY bonus rate for a season. Two-phase gate: - Before `start_time`: any direction allowed (configuration fix). - `start_time <= now < vesting_end_time`: strictly increase only — decreases would punish users who already chose to wait based on the advertised APY. - `now >= vesting_end_time`: rejected — some users may have already claimed with the old value; the rate must stay consistent. New value is capped at `MAX_APY_BONUS_BPS` and any increase is rejected if the contract balance cannot cover the resulting worst-case payout (`max_outstanding`).",
        "type": "object",
        "required": [
          "update_apy_bonus"
        ],
        "properties": {
          "update_apy_bonus": {
            "type": "object",
            "required": [
              "airdrop_id",
              "apy_bonus_bps"
            ],
            "properties": {
              "airdrop_id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "apy_bonus_bps": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "Uint128": {
        "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
        "type": "string"
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "airdrop"
        ],
        "properties": {
          "airdrop": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "latest_airdrop_id"
        ],
        "properties": {
          "latest_airdrop_id": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "user_airdrop_status"
        ],
        "properties": {
          "user_airdrop_status": {
            "type": "object",
            "required": [
              "address",
              "id"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Solvency snapshot for the given airdrop: - Σ eligibility committed to users - Σ already claimed - the current contract balance of the airdrop's token - whether the contract holds enough to cover the worst-case payout (all unclaimed users claim after vesting end and receive the APY bonus)",
        "type": "object",
        "required": [
          "solvency"
        ],
        "properties": {
          "solvency": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MigrateMsg",
    "type": "object",
    "additionalProperties": false
  },
  "sudo": null,
  "responses": {
    "airdrop": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AirdropResponse",
      "type": "object",
      "required": [
        "apy_bonus_bps",
        "id",
        "initial_claim_percent",
        "is_active",
        "is_native",
        "start_time",
        "token_address",
        "vesting_end_time",
        "vesting_start_time"
      ],
      "properties": {
        "apy_bonus_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "expiry_time": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "initial_claim_percent": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "is_active": {
          "type": "boolean"
        },
        "is_native": {
          "type": "boolean"
        },
        "start_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "token_address": {
          "type": "string"
        },
        "vesting_end_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "vesting_start_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ConfigResponse",
      "type": "object",
      "required": [
        "admin"
      ],
      "properties": {
        "admin": {
          "$ref": "#/definitions/Addr"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Addr": {
          "description": "A human readable address.\n\nIn Cosmos, this is typically bech32 encoded. But for multi-chain smart contracts no assumptions should be made other than being UTF-8 encoded and of reasonable length.\n\nThis type represents a validated address. It can be created in the following ways 1. Use `Addr::unchecked(input)` 2. Use `let checked: Addr = deps.api.addr_validate(input)?` 3. Use `let checked: Addr = deps.api.addr_humanize(canonical_addr)?` 4. Deserialize from JSON. This must only be done from JSON that was validated before such as a contract's state. `Addr` must not be used in messages sent by the user because this would result in unvalidated instances.\n\nThis type is immutable. If you really need to mutate it (Really? Are you sure?), create a mutable copy using `let mut mutable = Addr::to_string()` and operate on that `String` instance.",
          "type": "string"
        }
      }
    },
    "latest_airdrop_id": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LatestAirdropIdResponse",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "solvency": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SolvencyResponse",
      "type": "object",
      "required": [
        "airdrop_id",
        "contract_balance",
        "is_fully_funded",
        "is_native",
        "max_outstanding",
        "outstanding",
        "token_address",
        "total_claimed",
        "total_eligibility"
      ],
      "properties": {
        "airdrop_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "contract_balance": {
          "description": "Current contract balance for `token_address` (native via bank, CW20 via the contract's `Balance` query).",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "is_fully_funded": {
          "description": "True iff `contract_balance >= max_outstanding`.",
          "type": "boolean"
        },
        "is_native": {
          "type": "boolean"
        },
        "max_outstanding": {
          "description": "Worst-case outstanding: assumes every unclaimed user claims at or after `vesting_end_time` and receives the full APY bonus.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "outstanding": {
          "description": "`total_eligibility - total_claimed`. Note: forfeited mid-vesting portions reduce *paid* but not *eligibility*, so this is the pessimistic \"still-to-pay if everyone claims at vesting end\" bound, before APY bonus.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "token_address": {
          "type": "string"
        },
        "total_claimed": {
          "description": "Σ amounts actually paid out across all `Claim` calls so far.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "total_eligibility": {
          "description": "Σ amounts assigned via `AddAirdrop` / `UpdateEligibility`.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    },
    "user_airdrop_status": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserAirdropStatusResponse",
      "type": "object",
      "required": [
        "amount_claimed",
        "current_claimable",
        "is_claimed",
        "total_allocation",
        "vesting_status"
      ],
      "properties": {
        "amount_claimed": {
          "$ref": "#/definitions/Uint128"
        },
        "claim_time": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "current_claimable": {
          "description": "Amount claimable right now (vesting-aware calculation)",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "is_claimed": {
          "description": "Claim status",
          "type": "boolean"
        },
        "total_allocation": {
          "description": "Total tokens allocated to this user (from ELIGIBILITY)",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "vesting_status": {
          "description": "Vesting phase info for UX: \"not_started\" | \"in_progress\" | \"completed\"",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    }
  }
}
