            "expiry_time": {
              "description": "Required. Self-flagged follow-up to FIND-008/FIND-001 audit cycle: previously optional, but `None` had no admin escape — leftover tokens locked permanently. Now mandatory and validated to be strictly greater than `vesting_end_time` so `WithdrawFunds` always has a deterministic reclaim window.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
