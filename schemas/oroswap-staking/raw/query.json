{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "description": "Query messages exposed by the staking contract.",
  "oneOf": [
    {
      "description": "Returns the full contract configuration.",
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the current pool state.",
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the stake balance held by `address`.",
      "type": "object",
      "required": [
        "stake_of"
      ],
      "properties": {
        "stake_of": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the sum of all stake balances. Kept under the legacy `TotalShares` name for API stability; shares and ORO amounts are interchangeable.",
      "type": "object",
      "required": [
        "total_shares"
      ],
      "properties": {
        "total_shares": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns all pending reward coins accrued for `address`.",
      "type": "object",
      "required": [
        "pending_rewards"
      ],
      "properties": {
        "pending_rewards": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns all pending unbonding entries for `address`.",
      "type": "object",
      "required": [
        "unbonding_entries"
      ],
      "properties": {
        "unbonding_entries": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the configured unbonding period in seconds.",
      "type": "object",
      "required": [
        "unbonding_period"
      ],
      "properties": {
        "unbonding_period": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the total ORO currently locked in unbonding entries.",
      "type": "object",
      "required": [
        "total_locked"
      ],
      "properties": {
        "total_locked": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the addresses currently in the pause-authority set (excluding the owner, who has implicit authority).",
      "type": "object",
      "required": [
        "pause_authorities"
      ],
      "properties": {
        "pause_authorities": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
