# ── Zigchain node ─────────────────────────────────────────────────────────────
RPC_URL=https://public-zigchain-testnet-rpc.numia.xyz
CHAIN_ID=zigchain-1

# ── Keeper wallet ─────────────────────────────────────────────────────────────
# Mnemonic of the keeper wallet (must have uzig for gas)
MNEMONIC="word1 word2 word3 ... word24"

# ── Revenue Router contract ───────────────────────────────────────────────────
CONTRACT_ADDRESS=zig1...

# ── Skip API ──────────────────────────────────────────────────────────────────
SKIP_API_URL=https://go.skip.build/api/skip
# Optional: set if you have a Skip API key
# SKIP_API_KEY=

# ── Bridge config ─────────────────────────────────────────────────────────────
# USDC IBC denom on Zigchain
USDC_DENOM=ibc/6490A7EAB61059BFC1CDDEB05917DD70BDF3A611654162A1A47DB930D40D8AF4
# Source chain ID as registered in Skip
SOURCE_CHAIN_ID=zigchain-1
# Destination chain ID (Ethereum mainnet)
DEST_CHAIN_ID=1
# USDC contract address on Ethereum
DEST_USDC_DENOM=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Final receiver address on Ethereum
DEST_RECEIVER=0x...

# ── Keeper settings ───────────────────────────────────────────────────────────
# Minimum USDC balance (in uusdc) before bridging triggers
MIN_BRIDGE_AMOUNT=1000000
# How often to poll in seconds
POLL_INTERVAL_SECS=60
# Gas settings
GAS_PRICES=0.25uzig
GAS_ADJUSTMENT=1.3
